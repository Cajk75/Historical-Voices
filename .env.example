# =============================================================================
# Historical Voices — Environment Variables
# Copy this file to `.env.local` and fill in real values as you obtain them.
# Everything defaults to MOCK providers, so the app runs with NO keys set.
# Flip a provider to "real" by setting its *_PROVIDER var + the matching key.
# =============================================================================

# ---- App ----
# Public base URL of THIS tool (used in LTI redirect URIs & JWKS URL).
# Local dev: http://localhost:3000  |  Vercel: https://your-app.vercel.app
APP_URL="http://localhost:3000"

# ---- Database (Supabase Postgres) ----
# DATABASE_URL = pooled connection (pgbouncer, port 6543) for the app.
# DIRECT_URL   = direct connection (port 5432) for prisma migrate.
# Leave both unset to run WITHOUT a database (sessions kept in memory — dev only).
DATABASE_URL=""
DIRECT_URL=""

# ---- LTI 1.3 tool keys ----
# Generate with:  npm run keys:generate
# These are the tool's RSA keypair (private signs AGS calls, public served at JWKS).
LTI_PRIVATE_KEY=""
LTI_PUBLIC_KEY=""
# Random 32+ char string used to sign session cookies / OIDC state.
SESSION_SECRET="dev-only-change-me-to-a-long-random-string"

# ---- Canvas platform registration ----
# From Canvas Admin → Developer Keys → LTI Key. One platform shown; add more as needed.
CANVAS_ISSUER="https://canvas.instructure.com"
CANVAS_CLIENT_ID=""
CANVAS_AUTH_LOGIN_URL="https://sso.canvaslms.com/api/lti/authorize_redirect"
CANVAS_AUTH_TOKEN_URL="https://sso.canvaslms.com/login/oauth2/token"
CANVAS_JWKS_URL="https://sso.canvaslms.com/api/lti/security/jwks"
# Optional: skip real Canvas and use a built-in mock platform for local dev.
LTI_DEV_MODE="true"

# ---- Conversational engine (OpenAI) ----
CHAT_PROVIDER="mock"            # mock | openai
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"

# ---- Text-to-speech (ElevenLabs) ----
TTS_PROVIDER="mock"            # mock | elevenlabs
ELEVENLABS_API_KEY=""
# Voice id per persona (see src/lib/personas.ts). Falls back to default voice.
ELEVENLABS_VOICE_LINCOLN=""
ELEVENLABS_VOICE_KAHLO=""
ELEVENLABS_VOICE_ROOSEVELT=""

# ---- Avatar / lipsync (D-ID streaming, or Simli) ----
AVATAR_PROVIDER="mock"        # mock | did | simli
DID_API_KEY=""
SIMLI_API_KEY=""

# ---- Speech-to-text (Deepgram) ----
STT_PROVIDER="mock"           # mock | deepgram
DEEPGRAM_API_KEY=""

# ---- Translation glosses (DeepL) ----
TRANSLATE_PROVIDER="mock"     # mock | deepl | google
DEEPL_API_KEY=""
GOOGLE_TRANSLATE_API_KEY=""
